# These are read server-side by api/gemini.ts (the Vercel Edge Function
# proxy) via process.env — NOT prefixed with VITE_, so they are never
# bundled into client JS and the browser never sees them. This is the
# production-safe setup.
#
# For a real deployment: set these in Vercel's dashboard under
# Project Settings -> Environment Variables, then redeploy. This local
# .env file only matters if you test locally with `vercel dev` (not plain
# `vite dev` / `npm run dev` — Vite's dev server doesn't serve /api routes).

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"